# Public HTTPS address of this server (no trailing slash). Required.
PUBLIC_URL=https://wa.example.com

# Unlocks the OAuth consent page and /admin. Required, 12+ characters.
# Generate: openssl rand -base64 24
ADMIN_PASSWORD=

# Postgres (recommended) or a SQLite path. Default: /data/whatsapp.db
# DATABASE_URL=postgres://user:pass@host:5432/whatsapp?sslmode=disable

# Who the server may send to / read from. Comma-separated group JIDs
# (123...@g.us), phone numbers with country code, or * for everything.
# Empty = that ability is off. Find group JIDs on /admin after linking.
WA_SEND_ALLOW=
WA_READ_ALLOW=

# Max messages sent per hour, across all tools. Default 60.
# WA_SEND_PER_HOUR=60

# Optional: link with an 8-character code instead of scanning a QR.
# WA_PAIR_PHONE=447700900123

# Optional: static bearer token for clients that support headers
# (Claude Code, Claude Desktop config, scripts). 32+ characters.
# Generate: openssl rand -hex 32
# API_TOKEN=

# Optional: expose list_groups (every group the account is in). Default false.
# WA_DISCOVERY=false

# Name shown in WhatsApp > Linked devices. Default "WhatsApp MCP".
# WA_DEVICE_NAME=WhatsApp MCP

# Hosts allowed as OAuth redirect targets. Default claude.ai,claude.com,localhost,127.0.0.1
# OAUTH_REDIRECT_HOSTS=claude.ai,claude.com,localhost,127.0.0.1

# Optional: wake an agent when someone writes and nobody replies.
# POSTs to TRIGGER_URL when a TRIGGER_FROM sender writes in a TRIGGER_CHATS chat
# and no other device on this account replies within TRIGGER_DELAY_SECONDS.
# TRIGGER_FORMAT=claude-routine sends {"text": ...} with the headers a Claude
# Code routine API trigger needs; json sends the raw messages.
# TRIGGER_URL=https://api.anthropic.com/v1/claude_code/routines/<trigger-id>/fire
# TRIGGER_TOKEN=
# TRIGGER_FORMAT=claude-routine
# TRIGGER_CHATS=120363000000000001@g.us
# TRIGGER_FROM=447700900123
# TRIGGER_DELAY_SECONDS=90
# TRIGGER_PER_HOUR=20
